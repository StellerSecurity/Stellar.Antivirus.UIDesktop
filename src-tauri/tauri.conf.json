{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stellar Antivirus",
  "version": "0.1.4",
  "identifier": "org.stellarsecurity.antivirus.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stellar Antivirus",
        "width": 1200,
        "height": 720,
        "resizable": false,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://desktopreleasesassetsprod.stellarsecurity.com https://stellaruidesktopantivirusapiprod.azurewebsites.net;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MzEwQjYxRTY0NDUwMjQKUldRa1VFVG1ZUXN4WjJWd21wanVpNmo3bDFPdTNBRVp0R0gxREluTTRuMWVNNnYwQWRzY1hpSlAK",
      "endpoints": [
        "https://desktopreleasesassetsprod.stellarsecurity.com/antivirus/latest.json"
      ]
    }
  }
}
